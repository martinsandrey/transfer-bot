{
  "name": "transfer-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Transfer Bot - automação de monitoramento de chamadas (Fase 1: esqueleto)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "recon": "npm run build && node dist/recon/cli.js",
    "simular": "npm run build && node dist/main.js --simular",
    "relatorio": "npm run build && node dist/relatorio/cli.js",
    "telegram": "npm run build && node dist/telegram/cli.js",
    "testar-notificacao": "npm run build && node dist/main.js --teste-notificacao",
    "start": "npm run build && node dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "pino": "10.4.0",
    "playwright": "1.64.1",
    "telegram": "2.26.22",
    "zod": "4.6.7"
  }
}
