# Transfer Bot - configuração (copie para ".env" e edite; o ".env" NUNCA vai para o git)
# Esta é a proposta da Fase 1; os nomes podem mudar nas fases seguintes (ver docs/ARQUITETURA.md).

# --- Site (muda com frequência) ---
SITE_URL=https://exemplo.invalid/
SITE_USUARIO=
SITE_SENHA=
# Preencher usuário/senha automaticamente (1 tentativa) DEPOIS que você clicar na verificação do botão quadrado. Falso = login manual.
LOGIN_AUTOMATICO=false

# --- Modo de operação ---
# observacao (padrão): detecta, consulta e mostra a prévia no console, sem enviar.
# live: envia de verdade (exige confirmação digitada no console a cada inicialização).
SEND_MODE=observacao

# --- Monitoramento ---
INTERVALO_LEITURA_MS=1000
LEITURAS_CONFIRMACAO=2
AUSENCIA_MAX_LEITURAS=3
TTL_OCORRENCIAS_MIN=720
# Tempo máximo (segundos) entre a linha do Stage 1 sumir e a linha do Stage 3 aparecer para contar como a mesma transferência
JANELA_TRANSFERENCIA_SEG=60
# Para qual Stage vai a transferência que gera a mensagem: 2 = linha 1 → linha 2 (fluxo atual; a linha 3 é ignorada); 3 = fluxo antigo (linha 1 → Stage 3)
TRANSFERENCIA_DESTINO_STAGE=2
# Antepenúltimo dígito do número do funcionário que recebe a transferência (ex.: 2 = funcionários ***2**). "nenhum" = não conferir.
# Se a MESMA linha mudar de Stage 1 para o Stage acima, conta como transferência mesmo sem conferir o dígito.
TRANSFERENCIA_DESTINO_DIGITO=2
# Se o Stage 3 tocou e sumiu sem ninguém atender, espera tantos segundos (para o toque passar a outro agente) e então responde "CALLBACK" à mensagem de transferência
CALLBACK_ESPERA_SEG=3
# Também conta como CALLBACK a ligação que foi atendida no Stage 3 mas durou MENOS que tantos segundos (usa o "Call Duration" da linha do Stage 3). 0 = desligado
CALLBACK_DURACAO_SEG=20
# Só no RELATÓRIO: se depois de um CALLBACK o mesmo cliente for transferido de novo (por qualquer funcionário) em até tantos minutos
# e dessa vez for atendido por pelo menos CALLBACK_DURACAO_SEG segundos, o callback é removido e as duas contam como UMA transferência. 0 = desligado
CALLBACK_RELIGACAO_MIN=60
TIMEOUT_NAVEGACAO_MS=30000
TIMEOUT_CONSULTA_MS=60000
# Se ficar tantos minutos SEM nenhuma ligação na tabela, recarrega a página do site (evita tela "congelada" depois de horas). 0 = desligado
RECARGA_OCIOSA_MINUTOS=30
# Se a tabela tem ligações em andamento mas nada muda (nem a duração) há tantos minutos, a tela congelou: recarrega a página. 0 = desligado
# Se recarregar não resolver (3 vezes seguidas), o programa fecha e o iniciar.bat o abre de novo.
TABELA_PARADA_MINUTOS=5
# Se o envio atrasar mais que isso (ex.: Telegram fora do ar), a mensagem é descartada com aviso. 0 = nunca descarta.
VALIDADE_MENSAGEM_MIN=15

# --- Arquivos e pastas (fora do repositório; padrão: pasta do usuário no Windows) ---
PASTA_DADOS=
ARQUIVO_MENSAGEM=config/mensagem.txt
# Notificações do Windows (canto da tela) para erros e avisos relevantes: envio que falhou, sessão expirada, login necessário etc.
NOTIFICAR_WINDOWS=true
# Também notificar cada transferência detectada e cada CALLBACK (pode ser muita notificação). Padrão: false
NOTIFICAR_TRANSFERENCIAS=false
# Também notificar cada ligação que chegou a DURACAO_LONGA_MIN minutos (ligações de 5 min). Padrão: false
NOTIFICAR_5MIN=false
# Grava as mensagens em arquivos .txt (transferencias-concluidas.txt e ligacoes-5min.txt). Contêm dados de clientes: proteja a pasta.
REGISTRAR_MENSAGENS=true
PASTA_REGISTROS=registros
NIVEL_LOG=info
# Fuso horário de tudo que o programa mostra e grava (console, notificações, registros, relatório e log), independente do fuso do Windows.
# Padrão: horário de Brasília.
FUSO_HORARIO=America/Sao_Paulo

# --- Navegador ---
# msedge (Edge já instalado no Windows; padrão) ou chromium (baixado pelo Playwright: npx playwright install chromium)
NAVEGADOR=msedge

# --- Telegram (conta pessoal; só usado com SEND_MODE=live e nos comandos telegram.bat) ---
# Crie em https://my.telegram.org -> "API development tools". Trate o api_hash como senha.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Para onde as mensagens vão: "me" (suas Mensagens Salvas), o NOME exato do canal/grupo/contato (qualquer idioma, inclusive chinês),
# @usuario ou o ID numérico (veja: telegram.bat chats). Salve o .env em UTF-8. O ID é o mais seguro se houver nomes parecidos.
TELEGRAM_DESTINO=me
# Segundo grupo: ligações que chegam a DURACAO_LONGA_MIN minutos AINDA em Stage 1 (as já transferidas não entram). Vazio = desligado.
TELEGRAM_DESTINO_5MIN=
DURACAO_LONGA_MIN=5
# O mesmo cliente não recebe de novo a mensagem de 5 min dentro de tantos minutos (vale também depois de reiniciar o programa). 0 = desligado
REPETICAO_5MIN_MIN=30
# Quais funcionários geram mensagem em cada grupo. Vale o PENÚLTIMO dígito do Callback Number do Stage 1 (quem transferiu):
# o número termina em [linha][dono][qualquer]; o penúltimo é o "dono" (0 = equipe do paquistanês, 1 = a sua).
# Lista separada por vírgula (ex.: 1  ou  0,1  ou  1,2) ou * para todos.
# Transferências (e o aviso CALLBACK): padrão 1. Grupo de 5 minutos: padrão * (todos).
PENULTIMO_DIGITO_TRANSFERENCIA=1
PENULTIMO_DIGITO_5MIN=*
# Apelidos dos funcionários: numero=Nome, separados por ponto e vírgula. O apelido aparece SEMPRE junto do número (relatório e avisos).
# Exemplo: APELIDOS_FUNCIONARIOS=908113=Maria; 908114=João Silva
APELIDOS_FUNCIONARIOS=
# Penúltimo(s) dígito(s) que identificam a equipe do paquistanês no relatório (a caixa "Mostrar equipe do paquistanês" usa isto). Padrão: 0
EQUIPE_PAQUISTANES_DIGITOS=0
TIMEOUT_ENVIO_TELEGRAM_MS=30000
