# Transfer Bot - configuração (copie para ".env" e edite; o ".env" NUNCA vai para o git)
# Esta é a proposta da Fase 1; os nomes podem mudar nas fases seguintes (ver docs/ARQUITETURA.md).

# --- Site (muda com frequência) ---
SITE_URL=https://exemplo.invalid/
SITE_USUARIO=
SITE_SENHA=
# Tentar preencher o login automaticamente (1 tentativa). Se vazio/falso, o login é sempre manual.
LOGIN_AUTOMATICO=false

# --- Modo de operação ---
# observacao (padrão): detecta, consulta e mostra a prévia no console, sem enviar.
# live: envia de verdade (exige confirmação digitada no console a cada inicialização).
SEND_MODE=observacao

# --- Monitoramento ---
INTERVALO_LEITURA_MS=1000
LEITURAS_CONFIRMACAO=2
AUSENCIA_MAX_LEITURAS=3
TTL_OCORRENCIAS_MIN=720
TIMEOUT_NAVEGACAO_MS=30000
TIMEOUT_CONSULTA_MS=60000
RECARGA_OCIOSA_MINUTOS=0

# --- Arquivos e pastas (fora do repositório; padrão: pasta do usuário no Windows) ---
PASTA_DADOS=
ARQUIVO_MENSAGEM=config/mensagem.txt
NIVEL_LOG=info

# --- Navegador ---
# msedge (Edge já instalado no Windows; padrão) ou chromium (baixado pelo Playwright: npx playwright install chromium)
NAVEGADOR=msedge

# --- Telegram: NÃO definido (decisão pendente, ver docs/DECISOES.md). Nada aqui por enquanto. ---
